@startuml
hide footbox
skinparam style strictuml

participant "Joueur" as J
participant "case_sortie : Case" as Sortie
participant "InterfaceUI" as UI

J -> Sortie : tenterPassage()
activate Sortie

Sortie -> J : getScore()
J --> Sortie : scoreActuel

alt scoreActuel >= seuilRequis
    note right of Sortie : Critère 1 : La sortie se débloque
    Sortie -> UI : declencherVictoire()
    activate UI
    note right of UI : Critère 3 : Affichage du message
    UI -> UI : afficherMessage("Victoire")
    deactivate UI
    
else scoreActuel < seuilRequis
    note right of Sortie : Critère 2 : Joueur bloqué (pas assez de score)
    Sortie --> J : passageRefusé (reste sur la case)
end

deactivate Sortie
@enduml