@startuml
participant Jeu as j
participant Labyrinthe as l
participant Sortie as s
participant Joueur as pj
-> j : evoluer()
activate j
j -> pj : getScore()
activate pj
pj --> j : 1000
deactivate pj
j -> l : activerSortie()
activate l
l --> j
deactivate l
j -> pj : getX()
activate pj
pj-->j:x
deactivate pj
j -> pj : getY()
activate pj
pj-->j:y
deactivate pj
j -> l : estUneSortieActive(x, y)
activate l
l -> s : etreActive()
activate s
s --> l : true
deactivate s
l --> j : true
deactivate l
<-- j
deactivate l
deactivate j
-> j : etreFinis()
activate j
<-- j : true
deactivate j

@enduml