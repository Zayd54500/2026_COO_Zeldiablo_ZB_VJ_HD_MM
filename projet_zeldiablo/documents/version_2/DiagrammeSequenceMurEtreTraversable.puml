@startuml
skinparam style strictuml
skinparam SequenceMessageAlign center

participant ":Joueur" as J
participant "laby : Labyrinth" as L
participant "case_cible : Case" as C

Actor -> J : deplacement(dir, laby)

alt dir == 'N'
    opt this.posY > 0
        J -> L : getCase(this.posX, this.posY-1)
        L --> J : case_cible
        
        J -> C : etreTraversable()
        activate C
        C --> J : estTraversable
        deactivate C
        
        opt estTraversable == true
            J -> J : this.posY -= 1
        end
    end

else dir == 'S'
    J -> L : getTailleY()
    L --> J : tailleY

    opt this.posY < tailleY - 1
        J -> L : getCase(this.posX, this.posY+1)
        L --> J : case_cible
        
        J -> C : etreTraversable()
        activate C
        C --> J : estTraversable
        deactivate C
        
        opt estTraversable == true
            J -> J : this.posY += 1
        end
    end

else dir == 'O'
    opt this.posX > 0
        J -> L : getCase(this.posX-1, this.posY)
        activate L
        L --> J : case_cible
        deactivate L
        
        J -> C : etreTraversable()
        activate C
        C --> J : estTraversable
        deactivate C
        
        opt estTraversable == true
            J -> J : this.posX -= 1
        end
    end

else dir == 'E'
    J -> L : getTailleX()
    activate L
    L --> J : tailleX
    deactivate L

    opt this.posX < tailleX - 1
        J -> L : getCase(this.posX+1, this.posY)
        activate L
        L --> J : case_cible
        deactivate L
        
        J -> C : etreTraversable()
        activate C
        C --> J : estTraversable
        deactivate C
        
        opt estTraversable == true
            J -> J : this.posX += 1
        end
    end
end

J --> Actor : return
deactivate J

@enduml